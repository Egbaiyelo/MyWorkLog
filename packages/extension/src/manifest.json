{
    "manifest_version": 3,
    "name": "MyWorkLog-dev-0.0",
    "version": "0.1.0",
    "description": "Dev env to test myWorkLog",
    "background": {
        "service_worker": "background.bundle.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.myworkdayjobs.com/*"
            ],
            "js": [
                "content.bundle.js"
            ],
            "css": ["style.css"],
            "type": "module",
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "tabs",
        "nativeMessaging",
        "identity",
        "identity.email"
    ],
    "icons": {
        "16": "icons/log16.png",
        "48": "icons/log48.png",
        "128": "icons/log128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/log16.png",
            "24": "icons/log24.png",
            "32": "icons/log32.png"
        },
        "default_title": "MyWorkLog"
    },
    "host_permissions": [
        "https://*.myworkdayjobs.com/*",
        "https://www.google.com/s2/favicons*"
    ],
    "key": "",
    "oauth2": {
        "client_id": "343477439158-o44vju3bgtkjjq0sdu16nvl7kmde5shs.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/userinfo.profile"
        ]
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*",
                "pages/*",
                "files/*",
                "assets/*.png",
                "icons/*.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}